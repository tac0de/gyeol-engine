{
  "name": "@thedivineparadox/game-engine",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Reusable deterministic game runtime and explicit asset authoring tools",
  "files": [
    "dist",
    "templates",
    "README.md",
    "docs/visual-production.md",
    "docs/asset-production.md",
    "docs/standalone.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "exports": {
    "./runtime": {
      "types": "./dist/runtime/core/index.d.ts",
      "import": "./dist/runtime/core/index.js",
      "default": "./dist/runtime/core/index.js"
    },
    "./runtime/core": {
      "types": "./dist/runtime/core/index.d.ts",
      "import": "./dist/runtime/core/index.js",
      "default": "./dist/runtime/core/index.js"
    },
    "./runtime/browser/host": {
      "types": "./dist/runtime/browser/host.d.ts",
      "import": "./dist/runtime/browser/host.js",
      "default": "./dist/runtime/browser/host.js"
    },
    "./runtime/browser/assets": {
      "types": "./dist/runtime/browser/assets.d.ts",
      "import": "./dist/runtime/browser/assets.js",
      "default": "./dist/runtime/browser/assets.js"
    },
    "./runtime/browser/audio": {
      "types": "./dist/runtime/browser/audio.d.ts",
      "import": "./dist/runtime/browser/audio.js",
      "default": "./dist/runtime/browser/audio.js"
    },
    "./runtime/browser/hold-input": {
      "types": "./dist/runtime/browser/hold-input.d.ts",
      "import": "./dist/runtime/browser/hold-input.js",
      "default": "./dist/runtime/browser/hold-input.js"
    },
    "./runtime/react": {
      "types": "./dist/runtime/react/game-surface.d.ts",
      "import": "./dist/runtime/react/game-surface.js",
      "default": "./dist/runtime/react/game-surface.js"
    },
    "./tools": {
      "types": "./dist/tools/game.d.ts",
      "import": "./dist/tools/game.js",
      "default": "./dist/tools/game.js"
    },
    "./runtime/react/styles.css": "./dist/runtime/react/game-surface.css",
    "./package.json": "./package.json",
    "./tools/media": {
      "types": "./dist/tools/media.d.ts",
      "import": "./dist/tools/media.js",
      "default": "./dist/tools/media.js"
    },
    "./tools/asset-production": {
      "types": "./dist/tools/asset-production.d.ts",
      "import": "./dist/tools/asset-production.js",
      "default": "./dist/tools/asset-production.js"
    },
    "./tools/visual": {
      "types": "./dist/tools/visual.d.ts",
      "import": "./dist/tools/visual.js",
      "default": "./dist/tools/visual.js"
    },
    "./tools/standalone": {"types":"./dist/tools/standalone.d.ts","import":"./dist/tools/standalone.js","default":"./dist/tools/standalone.js"}
  },
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=24.2.0"
  },
  "bin": {"gyeol":"dist/tools/cli.js"},
  "scripts": {
    "build": "node scripts/build.ts",
    "test": "node --test tests/runtime/*.test.ts tests/package.test.ts tests/visual.test.ts tests/asset-production.test.ts tests/reproduction.test.ts tests/experiments.test.ts tests/standalone.test.ts",
    "check": "npm run build && npm test",
    "prepack": "npm run build",
    "test:visual-native": "node --test tests/visual-native.test.ts",
    "test:standalone": "node tests/standalone.integration.ts"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "vite": "^8.0.0",
    "typescript": "^7.0.0",
    "sharp": "^0.35.5"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "react": "19.3.0",
    "vite": "8.3.4",
    "typescript": "7.0.2",
    "sharp": "^0.35.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tac0de/gyeol-engine.git"
  }
}
