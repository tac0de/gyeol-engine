 assert.deepEqual(errors,[]);await writeFile(join(evidence,'persistence-result.json'),JSON.stringify({realBrowserCloseReopen:true,resumePosition:true,checkpointTimeRng:true,resumedRecordingFormat:2,resumedReplay:true,readOnlyMigration:true,explicitUpgrade:true,backupRecovery:true,backupWriteFailurePreserved:true,corruptResetConfirmed:true,quotaFailurePreserved:true,retryCommitted:true,deniedReadPreserved:true,futureVersionPreserved:true,errors},null,2));console.log('Persistent browser restart, migration, corruption, quota/denial, and checkpoint replay passed.');
}catch(error){if(context){const pages=context.pages();if(pages[0])await pages[0].screenshot({path:join(evidence,'failure.png'),fullPage:true}).catch(()=>{});}throw error;}
finally{await context?.close();await new Promise<void>((resolve,reject)=>server.httpServer.close(error=>error?reject(error):resolve()));await rm(profile,{recursive:true,force:true});}
