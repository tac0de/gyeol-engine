import {rules,solution} from '../src/rules.ts';import {PROGRESS_KEY} from '../src/progress.ts';
const args=process.argv.slice(2);if(args.length!==2||args[0]!=='--evidence-dir'||!isAbsolute(args[1]))throw Error('--evidence-dir ABS_PRIVATE_DIRECTORY');
const evidence=args[1];await mkdir(evidence,{recursive:true});const profile=await mkdtemp(join(process.env.AGENT_TEMP_DIR??tmpdir(),'gyeol-progress-'));
const root=resolve(import.meta.dirname,'..'),{preview}=await import('vite'),server=await preview({root,preview:{host:'127.0.0.1',port:0},logLevel:'error'});const address=server.httpServer!.address();if(!address||typeof address==='string')throw Error('Missing port');const url=`http://127.0.0.1:${address.port}`;
