async function launch(){context=await chromium.launchPersistentContext(profile,{headless:true,viewport:{width:1120,height:950},acceptDownloads:true});const page=context.pages()[0]??await context.newPage();page.on('pageerror',e=>errors.push(e.message));await page.goto(url);await page.getByRole('button',{name:'Start circuit'}).waitFor();return page;}
async function raw(page:Page){return page.evaluate(key=>localStorage.getItem(key),PROGRESS_KEY);}
async function inject(page:Page,text:string){await page.evaluate(({key,text})=>localStorage.setItem(key,text),{key:PROGRESS_KEY,text});await page.reload();await page.getByRole('button',{name:'Start circuit'}).waitFor();}
function encoded(version:number,payload:Json){let text:string|null=null;const slot=createSaveSlot({key:PROGRESS_KEY,gameId:rules.id,version,validate:(v):v is Json=>true,storage:()=>({getItem:()=>text,setItem:(_k,v)=>{text=v;},removeItem:()=>{text=null;}})});slot.load();assert.equal(slot.save(payload).status,'saved');return text!;}
async function denyWrites(page:Page){return page.evaluateHandle(key=>{const original=Storage.prototype.setItem;Storage.prototype.setItem=function(k,v){if(k===key)throw new DOMException('Controlled quota failure','QuotaExceededError');return original.call(this,k,v);};return ()=>{Storage.prototype.setItem=original;};},PROGRESS_KEY);}
