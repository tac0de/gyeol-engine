 assert.equal(await page.evaluate(()=>document.activeElement?.id),'continue');await page.getByRole('button',{name:'Continue circuit'}).click();assert.equal(await page.locator('#moves').textContent(),'02');assert.equal(await page.locator('#board').getAttribute('data-position'),String(before.state.position));
 for(const action of route.slice(2))await page.keyboard.press(keys[action.direction]);assert.equal(await page.locator('#screens').getAttribute('data-screen'),'result');
 const downloadPromise=page.waitForEvent('download');await page.getByRole('button',{name:'Export trail',exact:true}).click();const download=await downloadPromise,path=join(evidence,'resumed-trail.json');await download.saveAs(path);const recording=JSON.parse(await readFile(path,'utf8'));assert.equal(recording.format,2);assert.equal(recording.checkpoint.tick,reopenCheckpoint.tick);assert.equal(recording.checkpoint.random,reopenCheckpoint.random);assert.equal(replay(rules,recording).inspect().phase,'finished');
 await page.getByRole('button',{name:'Replay trail',exact:true}).click();await page.waitForFunction(()=>document.querySelector<HTMLElement>('#board')?.dataset.replayVerified==='true');
 // A valid historical envelope is a controlled fixture; its migration is exercised by the real app.
 const legacy=encoded(1,{run:before});await inject(page,legacy);assert.equal(await raw(page),legacy);assert.match(await page.locator('#save-status').textContent()??'',/older save/i);await page.screenshot({path:join(evidence,'migration.png'),fullPage:true});
 await page.getByRole('button',{name:'Continue circuit'}).click();assert.equal(await page.locator('#moves').textContent(),'02');const upgraded=JSON.parse((await raw(page))!);assert.equal(upgraded.current.version,2);assert.equal(upgraded.backup.version,1);
 await page.getByRole('button',{name:'Menu',exact:true}).click();await page.getByRole('button',{name:'Start circuit'}).click();for(const action of route.slice(0,2))await page.keyboard.press(keys[action.direction]);const damaged=JSON.parse((await raw(page))!);assert.equal(damaged.backup.payload.checkpoint.state.moves,1);damaged.current.payload.checkpoint.state.moves=999;const damagedText=JSON.stringify(damaged);await inject(page,damagedText);
 assert.equal(await raw(page),damagedText);assert.equal(await page.getByRole('button',{name:'Continue circuit'}).count(),0);await page.screenshot({path:join(evidence,'backup-available.png'),fullPage:true});
 const backupFault=await denyWrites(page);await page.getByRole('button',{name:'Restore backup'}).click();assert.equal(await raw(page),damagedText);assert.match(await page.locator('#save-status').textContent()??'',/Storage is full/);await backupFault.evaluate(restore=>restore());await backupFault.dispose();
 await page.getByRole('button',{name:'Restore backup'}).click();assert.equal(JSON.parse((await raw(page))!).current.payload.checkpoint.state.moves,1);assert.equal(await page.evaluate(()=>document.activeElement?.id),'continue');await page.getByRole('button',{name:'Continue circuit'}).click();assert.equal(await page.locator('#moves').textContent(),'01');
 await inject(page,'{broken');assert.equal(await raw(page),'{broken');await page.getByRole('button',{name:'Reset saved progress',exact:true}).click();await page.getByRole('button',{name:'Keep saved progress'}).click();assert.equal(await raw(page),'{broken');
 await page.getByRole('button',{name:'Reset saved progress',exact:true}).click();await page.getByRole('button',{name:'Delete saved progress'}).click();assert.equal(await raw(page),null);assert.equal(await page.evaluate(()=>document.activeElement?.id),'start');await page.getByRole('button',{name:'Start circuit'}).click();const quotaBefore=await raw(page),quotaFault=await denyWrites(page);
 await page.keyboard.press(keys[route[0].direction]);assert.equal(await page.locator('#moves').textContent(),'01');assert.equal(await raw(page),quotaBefore);assert.match(await page.locator('#save-status').textContent()??'',/Storage is full/);await page.screenshot({path:join(evidence,'quota-failure.png'),fullPage:true});
 await quotaFault.evaluate(restore=>restore());await quotaFault.dispose();await page.getByRole('button',{name:'Retry save'}).click();assert.equal(JSON.parse((await raw(page))!).current.payload.checkpoint.state.moves,1);await page.reload();await page.getByRole('button',{name:'Continue circuit'}).click();assert.equal(await page.locator('#moves').textContent(),'01');
 // Deny the localStorage getter on a new page; no real browser permission is lowered.
 const denied=await context!.newPage();denied.on('pageerror',e=>errors.push(e.message));await denied.addInitScript(()=>{const descriptor=Object.getOwnPropertyDescriptor(window,'localStorage')!;Object.defineProperty(window,'localStorage',{configurable:true,get(){throw new DOMException('Controlled access denial','SecurityError');}});(window as any).__restoreGetter=()=>Object.defineProperty(window,'localStorage',descriptor);});await denied.goto(url);assert.match(await denied.locator('#save-status').textContent()??'',/unavailable/i);await denied.getByRole('button',{name:'Start circuit'}).click();for(const action of route.slice(0,2))await denied.keyboard.press(keys[action.direction]);const storedBeforeDenied=await raw(page);await denied.evaluate(()=>(window as any).__restoreGetter());await denied.getByRole('button',{name:'Retry save'}).click();assert.equal(await raw(denied),storedBeforeDenied);await denied.keyboard.press(keys[route[2].direction]);assert.equal(await raw(denied),storedBeforeDenied);await denied.close();
