@import '@thedivineparadox/game-engine/runtime/browser/ui.css';
:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,sans-serif;color:#e9ede6;background:#111a1a;font-synthesis:none;color-scheme:dark}*{box-sizing:border-box}body{margin:0}.shell{max-width:1120px;padding:28px 44px 22px;margin:auto}header{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #35413d;padding-bottom:22px;font-size:11px;letter-spacing:1.5px}.brand{font-weight:850;color:#e9ede6;text-decoration:none;font-size:18px}.brand span{font-size:10px;color:#a3b1a9;margin-left:16px;font-weight:500}.edition{color:#9baaa1}.intro{padding:36px 0 28px}.eyebrow{font-size:10px;letter-spacing:2px;color:#e9b969;margin:0 0 12px}h1{font-size:clamp(36px,5vw,58px);font-weight:600;letter-spacing:-2px;line-height:1.05;margin:0 0 12px}.description{color:#aab8af;margin:0;font-size:15px}.play-layout{display:grid;grid-template-columns:minmax(0,1fr) 200px;gap:32px}.game-panel{background:#172524;border:1px solid #3e5048;min-width:0}.board-caption{display:flex;justify-content:space-between;padding:16px 20px;border-bottom:1px solid #2b3e36;font-size:10px;letter-spacing:1.5px;color:#9fb0a5}#phase{color:#f0c47e}canvas{display:block;width:100%;aspect-ratio:1.8;height:auto;outline-offset:-4px;touch-action:none;cursor:crosshair}canvas:focus-visible{outline:2px solid #edbd73}.hud{display:flex;gap:32px;align-items:center;padding:18px 20px;border-top:1px solid #2b3e36}.metric-label{font-size:9px;color:#a3b4a8;letter-spacing:1.8px;display:block;margin-bottom:6px}strong{font-size:20px;font-weight:500;font-variant-numeric:tabular-nums}.hud button{margin-left:auto;background:#e9bb72;color:#182523;border:0;padding:13px 16px;min-width:140px;font-weight:650}.hud button span{margin-left:16px}button,.file-button{font:inherit;cursor:pointer;transition:background .12s}button:focus-visible,.file-button:focus-within{outline:2px solid #e9bb72;outline-offset:3px}button:disabled{opacity:.4;cursor:default}aside{padding-top:4px}h2{font-size:21px;font-weight:500;line-height:1.2;letter-spacing:-.4px;margin:0 0 12px}aside p{font-size:12px;line-height:1.7;color:#aab9ae;margin:0 0 18px}.legend{display:grid;gap:12px;font-size:11px;margin:24px 0}.legend span{display:flex;align-items:center;gap:10px}.node{display:inline-block;width:9px;height:9px;border:2px solid;transform:rotate(45deg)}.amber{border-color:#e9bb72}.green{border-color:#7bceaa}.controls{text-align:center;padding:18px 0;border-top:1px solid #35413d;border-bottom:1px solid #35413d}kbd{display:inline-block;border:1px solid #506158;border-bottom-width:3px;padding:2px 8px;margin:2px;color:#e9ede6}.controls span{display:block;font-size:10px;margin-top:8px}.trail{padding-top:6px}.trail h3{font-size:13px;font-weight:500;margin:0 0 8px}.trail p{font-size:11px;margin-bottom:12px}.trail button,.file-button{display:block;width:100%;text-align:left;padding:8px 10px;background:transparent;border:1px solid #3b5146;color:#d4dfd5;font-size:11px;margin-top:7px}.trail button:hover:not(:disabled),.file-button:hover{background:#253b30}.file-button input{position:absolute;opacity:0;width:1px;height:1px}#message{font-size:12px;line-height:1.5;color:#c5d5c7;min-height:20px;margin:16px 0 28px}footer{border-top:1px solid #35413d;display:flex;justify-content:space-between;padding-top:18px;font-size:9px;color:#9aaca0;letter-spacing:1.5px}footer span:last-child{letter-spacing:0}@media(max-width:760px){.shell{padding:20px}.play-layout{grid-template-columns:1fr;gap:24px}aside{display:grid;grid-template-columns:1fr 1fr;gap:0 24px}aside h2,aside>p:not(.controls),.legend{grid-column:1}.controls{grid-column:1;margin-bottom:0}.trail{grid-column:2;grid-row:1 / span 4}.brand span{display:none}.intro{padding-top:28px}.hud{gap:22px;padding:16px}.hud button{min-width:120px;padding:12px}.edition{font-size:9px}}

/* Example theme; structural layout and focus behavior come from the opt-in engine UI. */
:root{--gyeol-focus:#e9bb72}header{gap:12px;flex-wrap:wrap}header nav{--gyeol-gap:8px}.quiet,.secondary{background:transparent;border:1px solid #506158;color:#d4dfd5;padding:10px 14px}.primary{background:#e9bb72;color:#182523;border:0;padding:14px 20px;font-weight:650}.import-control{margin:0;width:auto;padding:12px;font-size:11px;min-height:44px}.menu-panel{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,1fr);gap:48px;border:1px solid #3e5048;background:#172524}.menu-panel h2,.result-panel h2{font-size:clamp(28px,4vw,42px);line-height:1.1;letter-spacing:-1px}.menu-panel p,.result-panel p{color:#b1c1b6;line-height:1.7;margin:0}.menu-panel .eyebrow,.result-panel .eyebrow{color:#e9bb72}.menu-panel ol{list-style:none;justify-content:center;padding:0;margin:0;gap:24px}.menu-panel li{display:flex;gap:18px;align-items:center;font-size:13px;line-height:1.6;color:#b1c1b6}.menu-panel li b{font-weight:500;color:#e9bb72;font-size:11px}.menu-note{font-size:11px!important;color:#a3b4a8!important;line-height:1.6}.menu-nodes{display:flex;align-items:center;gap:10px;padding:18px 4px}.menu-nodes i{width:22px;height:22px;transform:rotate(45deg);border:2px solid #e9bb72;background:#344839}.menu-nodes span{width:48px;border-top:1px solid #59715c}.result-panel{background:#172524;border:1px solid #5c7861;min-height:300px;justify-content:center}.result-panel .gyeol-row{margin-top:12px}.gyeol-dialog{background:#172524;color:#e9ede6;border:1px solid #6d806b}.gyeol-dialog h2{font-size:30px}.gyeol-dialog p{color:#b1c1b6;font-size:13px;line-height:1.7}.gyeol-dialog .gyeol-stack{gap:10px;margin:24px 0}.trail .gyeol-action{min-height:44px}h1{overflow-wrap:anywhere}#pause-dialog:not([open]){display:none}@media(max-width:760px){.menu-panel{grid-template-columns:1fr;gap:30px}.menu-panel ol{border-top:1px solid #35413d;padding-top:24px}.hud{flex-wrap:wrap}.hud button{margin-left:auto}.brand span{display:none}header{align-items:flex-start}.gyeol-dialog h2{font-size:26px}}@media(prefers-reduced-motion:reduce){button,.file-button{transition:none}}

.progress-panel{border-top:1px solid #35413d;margin-top:22px;padding-top:14px}.progress-panel p{font-size:12px;line-height:1.6;color:#b8cbbd}.progress-panel .gyeol-row{--gyeol-gap:8px}.progress-panel button{font-size:11px}.progress-panel[data-status="quota_exceeded"],.progress-panel[data-status="corrupt"],.progress-panel[data-status="recoverable"]{border-color:#b7935c}
